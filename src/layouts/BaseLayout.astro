---
import "../styles/global.css";
import { siteConfig } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  lang?: "it" | "en";
}

const {
  title = "Maurizio Bertaboni",
  description = "Cybersecurity practitioner. Taking complicated systems apart until the simple, correct model underneath becomes visible.",
  lang = "it"
} = Astro.props;

const path = Astro.url.pathname;
const isEnglish = lang === "en";
const goatcounterCode = siteConfig.goatcounterCode.trim();

const nav = isEnglish
  ? [
      ["/en/", "Home"],
      ["/en/writing/", "Writing"],
      ["/en/projects/", "Projects"],
      ["/en/about/", "About"]
    ]
  : [
      ["/", "Home"],
      ["/writing/", "Writing"],
      ["/projects/", "Projects"],
      ["/about/", "About"]
    ];

const languageHref = isEnglish ? "/" : "/en/";
const languageLabel = isEnglish ? "IT" : "EN";
const privacyHref = isEnglish ? "/en/privacy/" : "/privacy/";
const themeLabelLight = isEnglish ? "Light" : "Chiaro";
const themeLabelDark = isEnglish ? "Dark" : "Scuro";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored === "dark" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    {goatcounterCode && (
      <script
        is:inline
        data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      />
    )}
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="identity" href={isEnglish ? "/en/" : "/"}>Maurizio Bertaboni</a>

        <nav aria-label="Main navigation">
          {nav.map(([href, label]) => (
            <a class:list={["nav-link", { active: path === href }]} href={href}>{label}</a>
          ))}
          <a class="language" href={languageHref}>{languageLabel}</a>
          <button
            type="button"
            class="theme-toggle"
            data-label-light={themeLabelLight}
            data-label-dark={themeLabelDark}
            aria-label={isEnglish ? "Toggle color theme" : "Cambia tema chiaro/scuro"}
          >
            {themeLabelDark}
          </button>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>
          Cybersecurity practitioner · Italy
          {" · "}
          <a href={siteConfig.linkedin}>LinkedIn</a>
          {" · "}
          <a href={siteConfig.github}>GitHub</a>
        </p>
        {isEnglish ? (
          <p class="footer-meta">
            Content © Maurizio Bertaboni ·{" "}
            <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
            {" "}— please credit the source. Provided as is, no warranty.{" "}
            <a href={privacyHref}>Privacy</a>
          </p>
        ) : (
          <p class="footer-meta">
            Contenuti © Maurizio Bertaboni ·{" "}
            <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
            {" "}— cita la fonte. Forniti “as is”, senza garanzie.{" "}
            <a href={privacyHref}>Privacy</a>
          </p>
        )}
      </footer>
    </div>

    <script is:inline>
      (function () {
        var key = "theme";
        var root = document.documentElement;
        var button = document.querySelector(".theme-toggle");
        if (!button) return;

        function current() {
          return root.getAttribute("data-theme") === "dark" ? "dark" : "light";
        }

        function syncLabel() {
          var theme = current();
          button.textContent =
            theme === "dark"
              ? button.getAttribute("data-label-light")
              : button.getAttribute("data-label-dark");
        }

        syncLabel();

        button.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem(key, next);
          } catch (e) {}
          syncLabel();
        });
      })();
    </script>
  </body>
</html>
