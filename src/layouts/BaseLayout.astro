---
import "../styles/global.css";
import { siteConfig } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  lang?: "it" | "en";
}

const {
  title = "Maurizio Bertaboni",
  description = "Cybersecurity practitioner. Taking complicated systems apart until the simple, correct model underneath becomes visible.",
  lang = "it"
} = Astro.props;

const path = Astro.url.pathname;
const isEnglish = lang === "en";
const goatcounterCode = siteConfig.goatcounterCode.trim();

const nav = isEnglish
  ? [
      ["/en/", "Home"],
      ["/en/writing/", "Writing"],
      ["/en/projects/", "Projects"],
      ["/en/about/", "About"]
    ]
  : [
      ["/", "Home"],
      ["/writing/", "Writing"],
      ["/projects/", "Projects"],
      ["/about/", "About"]
    ];

const languageHref = isEnglish ? "/" : "/en/";
const languageLabel = isEnglish ? "IT" : "EN";
const privacyHref = isEnglish ? "/en/privacy/" : "/privacy/";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
    <title>{title}</title>
    {goatcounterCode && (
      <script
        is:inline
        data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      />
    )}
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="identity" href={isEnglish ? "/en/" : "/"}>Maurizio Bertaboni</a>

        <nav aria-label="Main navigation">
          {nav.map(([href, label]) => (
            <a class:list={["nav-link", { active: path === href }]} href={href}>{label}</a>
          ))}
          <a class="language" href={languageHref}>{languageLabel}</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>Cybersecurity practitioner · Italy</p>
        {isEnglish ? (
          <p class="footer-meta">
            Content © Maurizio Bertaboni ·{" "}
            <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
            {" "}— please credit the source. Provided as is, no warranty.{" "}
            <a href={privacyHref}>Privacy</a>
          </p>
        ) : (
          <p class="footer-meta">
            Contenuti © Maurizio Bertaboni ·{" "}
            <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
            {" "}— cita la fonte. Forniti “as is”, senza garanzie.{" "}
            <a href={privacyHref}>Privacy</a>
          </p>
        )}
      </footer>
    </div>
  </body>
</html>
